    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "nodemon": "^3.1.10",
    "pdfjs-dist": "^6.4.299"
  }
