{
  "name": "planilla-checks",
  "version": "1.0.0",
  "description": "Aplicacion web para administrar planillas de creditos y cheques.",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "preview:ui": "node scripts/preview-ui.js",
