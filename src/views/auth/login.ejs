<%- include('../partials/head') %>
<main class="login-page d-flex align-items-center justify-content-center p-3">
  <section class="card login-card border-0 p-2 p-sm-4">
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-4">
        <span class="brand-mark"><i class="bi bi-check2-square"></i></span>
        <div>
          <h1 class="h4 mb-0">Planilla Checks</h1>
          <span class="text-muted small">Acceso al sistema</span>
        </div>
      </div>

      <% if (typeof error !== 'undefined') { %>
        <div class="alert alert-danger py-2"><%= error %></div>
      <% } %>

      <form action="/login" method="post">
        <div class="mb-3">
          <label class="form-label" for="email">Correo</label>
          <input class="form-control form-control-lg" id="email" name="email" type="email" value="<%= typeof email !== 'undefined' ? email : '' %>" autocomplete="username" required autofocus>
        </div>
        <div class="mb-4">
          <label class="form-label" for="password">Contrasena</label>
          <input class="form-control form-control-lg" id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button class="btn btn-primary btn-lg w-100" type="submit">Iniciar sesion</button>
      </form>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
