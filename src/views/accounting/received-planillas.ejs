<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="app-body">
  <%- include('../partials/sidebar') %>
  <main class="app-main">
    <div class="mb-4"><div class="page-eyebrow">Contabilidad</div><h1 class="h3 mb-1">Planillas recibidas</h1><p class="text-muted mb-0">Consulta de demostracion por fecha y agencia.</p></div>
    <section class="card mb-4"><div class="card-body p-4"><form class="row g-3 align-items-end" method="get"><div class="col-sm-6 col-lg-3"><label class="form-label" for="fecha">Fecha</label><input class="form-control" id="fecha" name="fecha" type="date" value="<%= filters.date %>"></div><div class="col-sm-6 col-lg-3"><label class="form-label" for="agencia">Agencia</label><select class="form-select" id="agencia" name="agencia"><option value="">Todas</option><option <%= filters.agency === 'Central' ? 'selected' : '' %>>Central</option><option <%= filters.agency === 'Norte' ? 'selected' : '' %>>Norte</option><option <%= filters.agency === 'Sur' ? 'selected' : '' %>>Sur</option></select></div><div class="col-auto"><button class="btn btn-primary" type="submit"><i class="bi bi-funnel me-2"></i>Filtrar</button></div><div class="col-auto"><a class="btn btn-outline-secondary" href="/contabilidad/planillas">Limpiar</a></div></form></div></section>
    <div class="row g-3 mb-4"><div class="col-sm-6"><div class="card"><div class="card-body"><div class="text-muted small">Total aprobado</div><div class="h3 mb-0"><%= currency.format(totals.approved) %></div></div></div></div><div class="col-sm-6"><div class="card"><div class="card-body"><div class="text-muted small">Total monto cheque</div><div class="h3 mb-0"><%= currency.format(totals.checks) %></div></div></div></div></div>
    <section class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>ID planilla</th><th>Agencia</th><th>Fecha</th><th>Solicitudes</th><th>Total aprobado</th><th>Total cheques</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody><% planillas.forEach((planilla) => { %><tr><td class="fw-semibold"><%= planilla.id %></td><td><%= planilla.agency %></td><td><%= planilla.date %></td><td><%= planilla.requests %></td><td><%= currency.format(planilla.approved) %></td><td><%= currency.format(planilla.checkAmount) %></td><td><span class="badge <%= planilla.status === 'PROCESADA' ? 'text-bg-success' : 'text-bg-warning' %>"><%= planilla.status %></span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/contabilidad/planillas/<%= planilla.id %>"><i class="bi bi-eye me-1"></i>Ver detalle</a></td></tr><% }) %></tbody></table></div></section>
  </main>
</div>
<%- include('../partials/footer') %>
