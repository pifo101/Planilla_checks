<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="app-body">
  <%- include('../partials/sidebar') %>
  <main class="app-main">
    <div class="mb-4"><div class="page-eyebrow">Contabilidad</div><h1 class="h3 mb-1">Historial de traslados</h1><p class="text-muted mb-0">La fecha filtra el momento de la decision en America/Guatemala; la fecha de envio permanece visible.</p></div>
    <section class="card mb-4"><div class="card-body p-4"><form class="row g-3 align-items-end" method="get">
      <div class="col-sm-6 col-lg-3"><label class="form-label" for="fecha">Fecha de decision</label><input class="form-control" id="fecha" name="fecha" type="date" value="<%= selectedDate %>" required></div>
      <div class="col-sm-6 col-lg-3"><label class="form-label" for="agencia">Agencia</label><select class="form-select" id="agencia" name="agencia"><option value="">Todas</option><% agencies.forEach((agency) => { %><option value="<%= agency.id %>" <%= selectedAgencyId === agency.id ? 'selected' : '' %>><%= agency.nombre %><%= agency.activo ? '' : ' (inactiva)' %></option><% }) %></select></div>
      <div class="col-sm-6 col-lg-3"><label class="form-label" for="resultado">Resultado</label><select class="form-select" id="resultado" name="resultado"><option value="todas" <%= selectedResult === 'todas' ? 'selected' : '' %>>Todas</option><option value="trasladadas" <%= selectedResult === 'trasladadas' ? 'selected' : '' %>>Trasladadas</option><option value="no-trasladadas" <%= selectedResult === 'no-trasladadas' ? 'selected' : '' %>>No trasladadas</option></select></div>
      <div class="col-auto"><button class="btn btn-primary" type="submit">Filtrar</button></div>
    </form></div></section>
    <div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Decisiones</div><div class="h3 mb-0"><%= summary.cantidadPlanillas %></div></div></div></div><div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Trasladadas</div><div class="h3 mb-0 text-success"><%= summary.cantidadTrasladadas %></div></div></div></div><div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">No trasladadas</div><div class="h3 mb-0 text-danger"><%= summary.cantidadNoTrasladadas %></div></div></div></div><div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Solicitudes / miembros</div><div class="h3 mb-0"><%= summary.cantidadRegistros %></div></div></div></div></div>
    <section class="card"><div class="table-responsive"><table class="table table-hover table-wide align-middle mb-0"><caption class="visually-hidden">Historial de decisiones de traslado</caption><thead><tr><th scope="col">Codigo / agencia</th><th scope="col">Acta</th><th scope="col">Envio</th><th scope="col">Resultado</th><th scope="col">Decision / usuario</th><th scope="col" class="cell-number">Registros</th><th scope="col" class="cell-money">Totales</th><th scope="col" class="table-actions">Acciones</th></tr></thead><tbody>
      <% if (planillas.length === 0) { %><tr><td class="text-center text-muted py-5" colspan="8">No hay decisiones para los filtros seleccionados.</td></tr><% } %>
      <% planillas.forEach((planilla) => { %><tr><td><div class="fw-semibold cell-code"><%= planilla.codigo %></div><div class="small text-muted"><%= planilla.agenciaNombre %></div></td><td class="cell-acta"><%= planilla.numeroActa || 'Sin acta' %></td><td class="cell-date"><%= dateTime.format(planilla.fechaEnvio) %></td><td><span class="badge <%= planilla.trasladado ? 'text-bg-success' : 'text-bg-danger' %>"><%= planilla.trasladado ? 'Trasladada' : 'No trasladada' %></span></td><td><div class="cell-date"><%= dateTime.format(planilla.fechaDecisionTraslado) %></div><div class="small text-muted"><%= planilla.decisionTrasladoUsuario %></div></td><td class="cell-number"><%= planilla.cantidadRegistros %></td><td class="small cell-money">Aprobado: <%= sqlCurrency.format(planilla.totalAprobado) %><br>Cancelado: <%= sqlCurrency.format(planilla.totalCancelado) %><br>Descuentos: <%= sqlCurrency.format(planilla.totalDescuentos) %><br>Cheque: <%= sqlCurrency.format(planilla.totalMontoCheque) %></td><td class="table-actions"><div class="d-grid gap-2"><a class="btn btn-sm btn-outline-primary" href="/contabilidad/planillas/<%= planilla.id %>?returnTo=<%= encodeURIComponent(returnTo) %>">Detalle</a><a class="btn btn-sm btn-primary" href="/contabilidad/planillas/<%= planilla.id %>/pdf" aria-label="Descargar PDF de la planilla <%= planilla.codigo %>"><i class="bi bi-file-earmark-pdf me-1"></i>Descargar PDF</a></div></td></tr><% }) %>
    </tbody></table></div>
    <% if (totalPages > 1) { const agencyQuery = selectedAgencyId == null ? '' : `&agencia=${selectedAgencyId}`; %><div class="card-footer bg-white d-flex flex-wrap justify-content-between gap-2"><span class="text-muted small"><%= total %> resultados · Pagina <%= page %> de <%= totalPages %></span><div class="btn-group"><% if (page === 1) { %><span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true">Anterior</span><% } else { %><a class="btn btn-sm btn-outline-secondary" href="?fecha=<%= selectedDate %>&resultado=<%= selectedResult %><%= agencyQuery %>&page=<%= page - 1 %>">Anterior</a><% } %><% if (page === totalPages) { %><span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true">Siguiente</span><% } else { %><a class="btn btn-sm btn-outline-secondary" href="?fecha=<%= selectedDate %>&resultado=<%= selectedResult %><%= agencyQuery %>&page=<%= page + 1 %>">Siguiente</a><% } %></div></div><% } %>
    </section>
  </main>
</div>
<%- include('../partials/footer') %>
