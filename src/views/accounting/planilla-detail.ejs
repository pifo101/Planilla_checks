<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="app-body">
  <%- include('../partials/sidebar') %>
  <main class="app-main">
    <a class="btn btn-sm btn-outline-secondary mb-3" href="/contabilidad/planillas"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    <div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><div class="page-eyebrow">Contabilidad</div><h1 class="h3 mb-1">Planilla <%= planilla.id %></h1><p class="text-muted mb-0"><%= planilla.agency %> · <%= planilla.date %></p></div><button class="btn btn-success align-self-end" type="button" disabled><i class="bi bi-lock me-2"></i>Marcar como procesada</button></div>
    <section class="card"><div class="card-body p-4"><div class="row g-4"><div class="col-sm-3"><div class="text-muted small">Solicitudes</div><div class="h4"><%= planilla.requests %></div></div><div class="col-sm-3"><div class="text-muted small">Total aprobado</div><div class="h4"><%= currency.format(planilla.approved) %></div></div><div class="col-sm-3"><div class="text-muted small">Total cheques</div><div class="h4"><%= currency.format(planilla.checkAmount) %></div></div><div class="col-sm-3"><div class="text-muted small">Estado</div><span class="badge text-bg-warning"><%= planilla.status %></span></div></div><hr><p class="text-muted mb-0">La accion de procesamiento esta deshabilitada hasta implementar persistencia y bloqueo de creditos.</p></div></section>
  </main>
</div>
<%- include('../partials/footer') %>
