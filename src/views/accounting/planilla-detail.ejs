<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="app-body">
  <%- include('../partials/sidebar') %>
  <main class="app-main">
    <a class="btn btn-sm btn-outline-secondary mb-3" href="/contabilidad/planillas"><i class="bi bi-arrow-left me-1"></i>Volver a planillas</a>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4"><div><div class="page-eyebrow">Contabilidad</div><h1 class="h3 mb-1">Planilla <%= planilla.codigo %></h1><p class="text-muted mb-0">Detalle historico de solo lectura.</p></div><span class="status-badge status-<%= planilla.estado.toLowerCase() %>"><%= planilla.estado %></span></div>

    <section class="card mb-4" aria-labelledby="planilla-information-title"><div class="card-body p-4"><h2 class="h5 mb-3" id="planilla-information-title">Informacion de la planilla</h2><div class="row g-4">
      <div class="col-6 col-lg"><div class="detail-label">Agencia</div><div class="fw-semibold"><%= planilla.agenciaNombre %></div></div>
      <div class="col-6 col-lg"><div class="detail-label">Numero de acta</div><div class="fw-semibold"><%= planilla.numeroActa || 'Sin asignar' %></div></div>
      <div class="col-6 col-lg"><div class="detail-label">Fecha de creacion</div><div class="fw-semibold"><%= dateTime.format(planilla.fechaCreacion) %></div></div>
      <div class="col-6 col-lg"><div class="detail-label">Fecha de envio</div><div class="fw-semibold"><%= dateTime.format(planilla.fechaEnvio) %></div></div>
      <div class="col-6 col-lg"><div class="detail-label">Usuario creador</div><div class="fw-semibold"><%= planilla.creadaPor %></div></div>
      <div class="col-6 col-lg"><div class="detail-label">Estado</div><div class="fw-semibold"><%= planilla.estado %></div></div>
    </div></div></section>

    <section class="card mb-4" aria-labelledby="requests-table-title"><div class="card-header bg-white border-0 px-4 pt-4"><h2 class="h5 mb-0" id="requests-table-title">Solicitudes y miembros</h2></div><div class="table-responsive"><table class="table table-hover mb-0"><caption class="visually-hidden">Registros de la planilla <%= planilla.codigo %></caption><thead><tr><th>Solicitud</th><th>Miembro tecnico</th><th>Cliente</th><th>Aprobado</th><th>Cancelado</th><th>Descuentos</th><th>Monto cheque</th><th>Numero cheque</th><th>Metodologia</th><th>Estado</th><th>Procesado</th><th>Fecha procesamiento</th></tr></thead><tbody>
      <% if (planilla.solicitudes.length === 0) { %><tr><td class="text-center text-muted py-5" colspan="12">Esta planilla no contiene registros.</td></tr><% } %>
      <% planilla.solicitudes.forEach((item) => { %><tr class="<%= item.procesado ? 'accounting-row-processed' : '' %>"><td class="fw-semibold"><%= item.numeroSolicitud %></td><td><%= item.miembroId || '-' %></td><td><%= item.nombreCliente %></td><td class="text-nowrap"><%= sqlCurrency.format(item.montoAprobado) %></td><td class="text-nowrap"><%= sqlCurrency.format(item.montoCancelado) %></td><td class="text-nowrap"><%= sqlCurrency.format(item.descuentos) %></td><td class="text-nowrap fw-semibold"><%= sqlCurrency.format(item.montoCheque) %></td><td><%= item.numeroCheque %></td><td><%= item.metodologia || '-' %></td><td><span class="status-badge status-<%= item.estado.toLowerCase() %>"><%= item.estado %></span></td><td><%= item.procesado ? 'Si' : 'No' %></td><td class="text-nowrap"><%= item.fechaProcesado ? dateTime.format(item.fechaProcesado) : '-' %></td></tr><% }) %>
    </tbody></table></div></section>

    <section class="card accounting-totals" aria-labelledby="planilla-totals-title"><div class="card-body"><h2 class="visually-hidden" id="planilla-totals-title">Totales de la planilla</h2><div class="row g-3">
      <div class="col-6 col-xl"><div class="detail-label">Registros</div><div class="h5 mb-0"><%= planilla.cantidadRegistros %></div></div>
      <div class="col-6 col-xl"><div class="detail-label">Total aprobado</div><div class="h5 mb-0"><%= sqlCurrency.format(planilla.totalAprobado) %></div></div>
      <div class="col-6 col-xl"><div class="detail-label">Total cancelado</div><div class="h5 mb-0"><%= sqlCurrency.format(planilla.totalCancelado) %></div></div>
      <div class="col-6 col-xl"><div class="detail-label">Total descuentos</div><div class="h5 mb-0"><%= sqlCurrency.format(planilla.totalDescuentos) %></div></div>
      <div class="col-6 col-xl"><div class="detail-label">Total monto cheque</div><div class="h5 mb-0 text-primary"><%= sqlCurrency.format(planilla.totalMontoCheque) %></div></div>
    </div></div></section>
  </main>
</div>
<%- include('../partials/footer') %>
