<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="app-body">
  <%- include('../partials/sidebar') %>
  <main class="app-main">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
      <div>
        <div class="page-eyebrow">Administracion</div>
        <h1 class="h3 mb-1">Administracion de usuarios</h1>
        <p class="text-muted mb-0">Gestiona usuarios, roles, agencias y acceso al sistema.</p>
      </div>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="demo-label"><i class="bi bi-stars"></i> Datos de demostracion</span>
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#newUserModal"><i class="bi bi-person-plus me-2"></i>Nuevo usuario</button>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <% [
        { label: 'Usuarios totales', value: summary.total, icon: 'bi-people' },
        { label: 'Usuarios activos', value: summary.active, icon: 'bi-person-check' },
        { label: 'Usuarios inactivos', value: summary.inactive, icon: 'bi-person-dash' },
        { label: 'Asistentes', value: summary.assistants, icon: 'bi-person-workspace' }
      ].forEach((metric) => { %>
        <div class="col-6 col-xl-3">
          <article class="card admin-summary-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
              <span class="metric-icon bg-primary-subtle text-primary"><i class="bi <%= metric.icon %>"></i></span>
              <div><div class="text-muted small"><%= metric.label %></div><div class="h3 mb-0"><%= metric.value %></div></div>
            </div>
          </article>
        </div>
      <% }) %>
    </div>

    <section class="card mb-4" aria-labelledby="user-filters-title">
      <div class="card-body p-4">
        <h2 class="visually-hidden" id="user-filters-title">Filtros de usuarios</h2>
        <form class="row g-3 align-items-end" data-admin-filters>
          <div class="col-12 col-lg-4">
            <label class="form-label" for="userSearch">Buscar</label>
            <div class="input-group"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span><input class="form-control" id="userSearch" type="search" placeholder="Nombre o correo" data-user-search></div>
          </div>
          <div class="col-6 col-md-4 col-lg-2">
            <label class="form-label" for="roleFilter">Rol</label>
            <select class="form-select" id="roleFilter" data-user-role><option value="">Todos</option><option>ADMIN</option><option>ASISTENTE</option><option>CONTABILIDAD</option></select>
          </div>
          <div class="col-6 col-md-4 col-lg-3">
            <label class="form-label" for="agencyFilter">Agencia</label>
            <select class="form-select" id="agencyFilter" data-user-agency><option value="">Todas las agencias</option><option>Oficina central</option><% agencies.forEach((agency) => { %><option><%= agency.name %></option><% }) %></select>
          </div>
          <div class="col-6 col-md-4 col-lg-2">
            <label class="form-label" for="statusFilter">Estado</label>
            <select class="form-select" id="statusFilter" data-user-status><option value="">Todos</option><option>ACTIVO</option><option>INACTIVO</option></select>
          </div>
          <div class="col-6 col-lg-1 d-grid"><button class="btn btn-outline-secondary" type="reset" aria-label="Limpiar filtros"><i class="bi bi-arrow-counterclockwise"></i></button></div>
        </form>
      </div>
    </section>

    <section class="card" aria-labelledby="users-table-title">
      <div class="card-header bg-white border-0 px-4 pt-4 d-flex justify-content-between align-items-center gap-3">
        <h2 class="h5 mb-0" id="users-table-title">Usuarios registrados</h2>
        <span class="small text-muted" data-user-count><%= users.length %> resultados</span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <caption class="visually-hidden">Listado de usuarios de demostracion</caption>
          <thead><tr><th scope="col">Usuario</th><th scope="col">Correo</th><th scope="col">Rol</th><th scope="col">Agencia</th><th scope="col">Estado</th><th scope="col">Ultimo acceso</th><th scope="col" class="text-end">Acciones</th></tr></thead>
          <tbody>
            <% users.forEach((user) => { %>
              <tr data-user-row data-search="<%= `${user.name} ${user.email}`.toLowerCase() %>" data-role="<%= user.role %>" data-agency="<%= user.agency %>" data-status="<%= user.status %>">
                <td><div class="d-flex align-items-center gap-2"><span class="user-avatar"><%= user.name.split(' ').map((part) => part[0]).slice(0, 2).join('') %></span><span class="fw-semibold"><%= user.name %></span></div></td>
                <td><a href="mailto:<%= user.email %>"><%= user.email %></a></td>
                <td><span class="badge role-badge role-<%= user.role.toLowerCase() %>"><%= user.role %></span></td>
                <td><%= user.agency %></td>
                <td><span class="status-badge status-<%= user.status.toLowerCase() %>"><i class="bi bi-circle-fill"></i><%= user.status %></span></td>
                <td class="text-muted text-nowrap"><%= user.lastAccess %></td>
                <td class="text-end"><div class="dropdown"><button class="btn btn-sm btn-light" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Acciones para <%= user.name %>"><i class="bi bi-three-dots"></i></button><ul class="dropdown-menu dropdown-menu-end"><li><button class="dropdown-item" type="button" data-prototype-action="Ver usuario"><i class="bi bi-eye me-2"></i>Ver</button></li><li><button class="dropdown-item" type="button" data-prototype-action="Editar usuario"><i class="bi bi-pencil me-2"></i>Editar</button></li><li><button class="dropdown-item" type="button" data-prototype-action="<%= user.status === 'ACTIVO' ? 'Desactivar' : 'Activar' %> usuario"><i class="bi <%= user.status === 'ACTIVO' ? 'bi-person-dash' : 'bi-person-check' %> me-2"></i><%= user.status === 'ACTIVO' ? 'Desactivar' : 'Activar' %></button></li></ul></div></td>
              </tr>
            <% }) %>
            <tr class="d-none" data-users-empty><td class="text-center text-muted py-5" colspan="7"><i class="bi bi-search d-block fs-3 mb-2"></i>No se encontraron usuarios con esos filtros.</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <div class="alert alert-info mt-3 d-none" role="status" data-admin-feedback></div>
  </main>
</div>

<div class="modal fade" id="newUserModal" tabindex="-1" aria-labelledby="newUserModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form data-new-user-form>
    <div class="modal-header"><div><div class="page-eyebrow">Prototipo visual</div><h2 class="modal-title h5" id="newUserModalLabel">Nuevo usuario</h2></div><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <div class="modal-body"><div class="alert alert-info small"><i class="bi bi-info-circle me-2"></i>Los datos no se guardaran. La conexion con backend esta pendiente.</div><div class="row g-3">
      <div class="col-12"><label class="form-label" for="fullName">Nombre completo</label><input class="form-control" id="fullName" name="nombre" type="text" autocomplete="name" required></div>
      <div class="col-12"><label class="form-label" for="email">Correo</label><input class="form-control" id="email" name="correo" type="email" autocomplete="email" required></div>
      <div class="col-md-6"><label class="form-label" for="password">Contrasena</label><input class="form-control" id="password" name="contrasena" type="password" autocomplete="new-password" required></div>
      <div class="col-md-6"><label class="form-label" for="confirmPassword">Confirmar contrasena</label><input class="form-control" id="confirmPassword" name="confirmarContrasena" type="password" autocomplete="new-password" required></div>
      <div class="col-md-4"><label class="form-label" for="newRole">Rol</label><select class="form-select" id="newRole" name="rol" required><option value="">Seleccionar</option><option>ADMIN</option><option>ASISTENTE</option><option>CONTABILIDAD</option></select></div>
      <div class="col-md-4"><label class="form-label" for="newAgency">Agencia</label><select class="form-select" id="newAgency" name="agencia" required><option value="">Seleccionar</option><option>Oficina central</option><% agencies.forEach((agency) => { %><option><%= agency.name %></option><% }) %></select></div>
      <div class="col-md-4"><label class="form-label" for="newStatus">Estado</label><select class="form-select" id="newStatus" name="estado" required><option>ACTIVO</option><option>INACTIVO</option></select></div>
    </div><div class="alert alert-warning mt-3 mb-0 d-none" role="status" data-user-form-feedback></div></div>
    <div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" type="submit">Crear usuario</button></div>
  </form></div></div>
</div>
<script src="/js/admin.js"></script>
<%- include('../partials/footer') %>
