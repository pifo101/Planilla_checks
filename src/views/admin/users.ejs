<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="app-body">
  <%- include('../partials/sidebar') %>
  <main class="app-main">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
      <div>
        <div class="page-eyebrow">Administracion</div>
        <h1 class="h3 mb-1">Usuarios</h1>
        <p class="text-muted mb-0">Vista inicial con registros de demostracion.</p>
      </div>
      <button class="btn btn-primary" type="button" disabled><i class="bi bi-person-plus me-2"></i>Nuevo usuario</button>
    </div>

    <section class="card">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th>Nombre</th><th>Usuario / email</th><th>Rol</th><th>Agencia</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
          <tbody>
            <% users.forEach((user) => { %>
              <tr>
                <td class="fw-semibold"><%= user.name %></td>
                <td><%= user.email %></td>
                <td><span class="badge text-bg-light"><%= user.role %></span></td>
                <td><%= user.agency %></td>
                <td><span class="badge <%= user.status === 'ACTIVO' ? 'text-bg-success' : 'text-bg-secondary' %>"><%= user.status %></span></td>
                <td class="text-end"><button class="btn btn-sm btn-outline-secondary" type="button" disabled><i class="bi bi-pencil"></i> Editar</button></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</div>
<%- include('../partials/footer') %>
