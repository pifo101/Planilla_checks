<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="app-body">
  <%- include('../partials/sidebar') %>
  <main class="app-main">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
      <div>
        <div class="page-eyebrow">Administracion</div>
        <h1 class="h3 mb-1">Administracion de usuarios</h1>
        <p class="text-muted mb-0">Gestiona usuarios, roles, agencias y acceso al sistema.</p>
      </div>
      <a class="btn btn-primary" href="/admin/usuarios/nuevo"><i class="bi bi-person-plus me-2"></i>Crear usuario</a>
    </div>

    <% if (message) { %><div class="alert alert-success" role="status"><%= message %></div><% } %>
    <% if (typeof error !== 'undefined') { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>

    <div class="row g-3 mb-4">
      <% [
        { label: 'Usuarios totales', value: summary.total, icon: 'bi-people' },
        { label: 'Usuarios activos', value: summary.active, icon: 'bi-person-check' },
        { label: 'Usuarios bloqueados', value: summary.blocked, icon: 'bi-person-dash' },
        { label: 'Asistentes', value: summary.assistants, icon: 'bi-person-workspace' }
      ].forEach((metric) => { %>
        <div class="col-6 col-xl-3">
          <article class="card admin-summary-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
              <span class="metric-icon bg-primary-subtle text-primary"><i class="bi <%= metric.icon %>"></i></span>
              <div><div class="text-muted small"><%= metric.label %></div><div class="h3 mb-0"><%= metric.value %></div></div>
            </div>
          </article>
        </div>
      <% }) %>
    </div>

    <section class="card mb-4" aria-labelledby="user-filters-title">
      <div class="card-body p-4">
        <h2 class="visually-hidden" id="user-filters-title">Filtros de usuarios</h2>
        <form class="row g-3 align-items-end" data-admin-filters>
          <div class="col-12 col-lg-4">
            <label class="form-label" for="userSearch">Buscar</label>
            <div class="input-group"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span><input class="form-control" id="userSearch" type="search" placeholder="Nombre o correo" data-user-search></div>
          </div>
          <div class="col-6 col-md-4 col-lg-2">
            <label class="form-label" for="roleFilter">Rol</label>
            <select class="form-select" id="roleFilter" data-user-role><option value="">Todos</option><% roles.forEach((role) => { %><option value="<%= role %>"><%= roleLabels[role] %></option><% }) %></select>
          </div>
          <div class="col-6 col-md-4 col-lg-3">
            <label class="form-label" for="agencyFilter">Agencia</label>
            <select class="form-select" id="agencyFilter" data-user-agency><option value="">Todas las agencias</option><% agencyFilters.forEach((agencyName) => { %><option value="<%= agencyName %>"><%= agencyName %></option><% }) %></select>
          </div>
          <div class="col-6 col-md-4 col-lg-2">
            <label class="form-label" for="statusFilter">Estado</label>
            <select class="form-select" id="statusFilter" data-user-status><option value="">Todos</option><option value="ACTIVO">Activo</option><option value="BLOQUEADO">Bloqueado</option></select>
          </div>
          <div class="col-6 col-lg-1 d-grid"><button class="btn btn-outline-secondary" type="reset" aria-label="Limpiar filtros"><i class="bi bi-arrow-counterclockwise"></i></button></div>
        </form>
      </div>
    </section>

    <section class="card" aria-labelledby="users-table-title">
      <div class="card-header bg-white border-0 px-4 pt-4 d-flex justify-content-between align-items-center gap-3">
        <h2 class="h5 mb-0" id="users-table-title">Usuarios registrados</h2>
        <span class="small text-muted" data-user-count><%= users.length %> resultados</span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <caption class="visually-hidden">Listado de usuarios registrados</caption>
          <thead><tr><th scope="col">Usuario</th><th scope="col">Correo</th><th scope="col">Rol</th><th scope="col">Agencia</th><th scope="col">Estado</th><th scope="col">Creado</th><th scope="col" class="text-end">Accion</th></tr></thead>
          <tbody>
            <% users.forEach((user) => { const status = user.activo ? 'ACTIVO' : 'BLOQUEADO'; const formId = `user-access-${user.id}`; %>
              <tr data-user-row data-search="<%= `${user.nombre} ${user.email}`.toLowerCase() %>" data-role="<%= user.rol %>" data-agency="<%= user.agenciaNombre || '' %>" data-status="<%= status %>">
                <td><div class="d-flex align-items-center gap-2"><span class="user-avatar"><%= user.nombre.split(' ').map((part) => part[0]).slice(0, 2).join('') %></span><span class="fw-semibold"><%= user.nombre %></span></div></td>
                <td><a href="mailto:<%= user.email %>"><%= user.email %></a></td>
                <td><select class="form-select form-select-sm" name="rol" form="<%= formId %>" aria-label="Rol de <%= user.nombre %>" data-access-role><% roles.forEach((role) => { %><option value="<%= role %>" <%= user.rol === role ? 'selected' : '' %>><%= roleLabels[role] %></option><% }) %></select></td>
                <td><select class="form-select form-select-sm" name="agenciaId" form="<%= formId %>" aria-label="Agencia de <%= user.nombre %>" data-access-agency><option value="">Sin agencia</option><% agencies.forEach((agency) => { %><option value="<%= agency.id %>" <%= Number(user.agenciaId) === Number(agency.id) ? 'selected' : '' %>><%= agency.nombre %></option><% }) %></select></td>
                <td><select class="form-select form-select-sm" name="activo" form="<%= formId %>" aria-label="Estado de <%= user.nombre %>"><option value="true" <%= user.activo ? 'selected' : '' %>>Activo</option><option value="false" <%= !user.activo ? 'selected' : '' %>>Bloqueado</option></select></td>
                <td class="text-muted text-nowrap"><%= dateTime.format(user.createdAt) %></td>
                <td class="text-end"><form id="<%= formId %>" action="/admin/usuarios/<%= user.id %>" method="post" data-user-access-form><button class="btn btn-sm btn-outline-primary" type="submit"><i class="bi bi-check2 me-1"></i>Guardar</button></form></td>
              </tr>
            <% }) %>
            <tr class="<%= users.length ? 'd-none' : '' %>" data-users-empty><td class="text-center text-muted py-5" colspan="7"><i class="bi bi-search d-block fs-3 mb-2"></i>No se encontraron usuarios con esos filtros.</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</div>
<script src="/js/admin.js"></script>
<%- include('../partials/footer') %>
