<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="app-body">
  <%- include('../partials/sidebar') %>
  <main class="app-main">
    <a class="btn btn-sm btn-outline-secondary mb-3" href="/admin/usuarios"><i class="bi bi-arrow-left me-1"></i>Volver a usuarios</a>
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
      <div>
        <div class="page-eyebrow">Administracion</div>
        <h1 class="h3 mb-1">Crear cuenta de usuario</h1>
        <p class="text-muted mb-0">Registra la informacion y asignacion inicial del usuario.</p>
      </div>
      <span class="demo-label"><i class="bi bi-stars"></i> Simulacion frontend</span>
    </div>

    <div class="alert alert-info d-none admin-form-feedback" role="status" tabindex="-1" data-account-success>
      <div><strong>Cuenta simulada correctamente.</strong> No se guardaron datos porque la conexion con backend esta pendiente.</div>
      <a class="alert-link text-nowrap" href="/admin/usuarios">Volver a usuarios</a>
    </div>

    <form class="card admin-form-card" data-account-form novalidate>
      <div class="card-body p-4 p-lg-5">
        <div class="alert alert-info small mb-4"><i class="bi bi-info-circle me-2"></i>Esta pantalla es un prototipo funcional. Ninguna cuenta sera almacenada.</div>

        <section aria-labelledby="user-information-title">
          <div class="form-section-heading">
            <span class="form-section-icon" aria-hidden="true"><i class="bi bi-person"></i></span>
            <div><h2 class="h5 mb-1" id="user-information-title">Informacion del usuario</h2><p class="small text-muted mb-0">Datos que identificaran la cuenta dentro del sistema.</p></div>
          </div>
          <div class="row g-3 mt-1">
            <div class="col-12 col-lg-6">
              <label class="form-label" for="fullName">Nombre completo <span class="required-mark" aria-hidden="true">*</span></label>
              <input class="form-control" id="fullName" name="nombre" type="text" autocomplete="name" aria-describedby="fullNameError" required>
              <div class="invalid-feedback" id="fullNameError">Ingresa el nombre completo.</div>
            </div>
            <div class="col-12 col-lg-6">
              <label class="form-label" for="email">Correo electronico <span class="required-mark" aria-hidden="true">*</span></label>
              <input class="form-control" id="email" name="correo" type="email" autocomplete="email" aria-describedby="emailError" required>
              <div class="invalid-feedback" id="emailError">Ingresa un correo electronico valido.</div>
            </div>
            <div class="col-12 col-lg-6">
              <label class="form-label" for="password">Contrasena <span class="required-mark" aria-hidden="true">*</span></label>
              <div class="input-group has-validation">
                <input class="form-control" id="password" type="password" autocomplete="new-password" aria-describedby="passwordError" required>
                <button class="btn btn-outline-secondary password-toggle" type="button" data-password-toggle="password" aria-label="Mostrar contrasena" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button>
                <div class="invalid-feedback" id="passwordError">Ingresa una contrasena.</div>
              </div>
            </div>
            <div class="col-12 col-lg-6">
              <label class="form-label" for="confirmPassword">Confirmar contrasena <span class="required-mark" aria-hidden="true">*</span></label>
              <div class="input-group has-validation">
                <input class="form-control" id="confirmPassword" type="password" autocomplete="new-password" aria-describedby="confirmPasswordError" required>
                <button class="btn btn-outline-secondary password-toggle" type="button" data-password-toggle="confirmPassword" aria-label="Mostrar confirmacion de contrasena" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button>
                <div class="invalid-feedback" id="confirmPasswordError">Confirma la contrasena.</div>
              </div>
            </div>
          </div>
        </section>

        <hr class="my-4 my-lg-5">

        <section aria-labelledby="assignment-title">
          <div class="form-section-heading">
            <span class="form-section-icon" aria-hidden="true"><i class="bi bi-person-gear"></i></span>
            <div><h2 class="h5 mb-1" id="assignment-title">Asignacion</h2><p class="small text-muted mb-0">Define el rol, la agencia y el estado inicial.</p></div>
          </div>
          <div class="row g-3 mt-1">
            <div class="col-12 col-lg-4">
              <label class="form-label" for="newRole">Rol <span class="required-mark" aria-hidden="true">*</span></label>
              <select class="form-select" id="newRole" name="rol" aria-describedby="roleError" data-account-role required>
                <option value="">Seleccionar rol</option>
                <option value="ADMIN">Administrador</option>
                <option value="ASISTENTE">Asistente de Agencia</option>
                <option value="CONTABILIDAD">Contabilidad</option>
              </select>
              <div class="invalid-feedback" id="roleError">Selecciona un rol.</div>
            </div>
            <div class="col-12 col-lg-4" data-agency-field>
              <label class="form-label" for="newAgency">Agencia <span class="required-mark d-none" aria-hidden="true" data-agency-required>*</span></label>
              <select class="form-select" id="newAgency" name="agencia" aria-describedby="agencyContext agencyError" data-account-agency disabled>
                <option value="">Seleccionar agencia</option>
                <option value="NO_APLICA">No aplica</option>
                <% agencies.forEach((agency) => { %><option value="<%= agency.code %>"><%= agency.name %></option><% }) %>
              </select>
              <div class="form-text field-context" id="agencyContext" data-agency-context>La agencia no aplica para el rol seleccionado.</div>
              <div class="invalid-feedback" id="agencyError">Selecciona una agencia para el Asistente de Agencia.</div>
            </div>
            <div class="col-12 col-lg-4">
              <label class="form-label" for="newStatus">Estado inicial <span class="required-mark" aria-hidden="true">*</span></label>
              <select class="form-select" id="newStatus" name="estado" required><option value="ACTIVO">Activo</option><option value="INACTIVO">Inactivo</option></select>
            </div>
          </div>
        </section>
      </div>
      <div class="card-footer admin-form-actions d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 p-4">
        <a class="btn btn-outline-secondary" href="/admin/usuarios">Cancelar</a>
        <button class="btn btn-primary" type="button" data-account-submit><i class="bi bi-person-plus me-2"></i>Crear cuenta</button>
      </div>
    </form>
  </main>
</div>
<script src="/js/admin.js"></script>
<%- include('../partials/footer') %>
