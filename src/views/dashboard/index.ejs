<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="app-body">
  <%- include('../partials/sidebar') %>
  <main class="app-main">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
      <div>
        <div class="page-eyebrow">Resumen general</div>
        <h1 class="h3 mb-1">Dashboard administrativo</h1>
        <p class="text-muted mb-0">Consulta el estado general de usuarios, agencias y planillas.</p>
      </div>
      <span class="demo-label"><i class="bi bi-stars"></i> Datos de demostracion</span>
    </div>

    <div class="row g-3 mb-4">
      <% metrics.forEach((metric) => { %>
        <div class="col-sm-6 col-xl-3">
          <article class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="text-muted small"><%= metric.label %></div>
                <div class="h2 fw-semibold mb-1"><%= metric.value %></div>
                <div class="small text-muted"><%= metric.detail %></div>
              </div>
              <span class="metric-icon bg-<%= metric.tone %>-subtle text-<%= metric.tone %>">
                <i class="bi <%= metric.icon %>"></i>
              </span>
            </div>
          </article>
        </div>
      <% }) %>
    </div>

    <section class="card">
      <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Actividad reciente</h2>
        <a class="btn btn-sm btn-outline-primary" href="/admin/usuarios">Ver usuarios</a>
      </div>
      <div class="card-body px-4">
        <% activities.forEach((activity, index) => { %>
          <div class="d-flex gap-3 <%= index < activities.length - 1 ? 'border-bottom pb-3 mb-3' : '' %>">
            <span class="activity-icon" aria-hidden="true"><i class="bi <%= activity.icon %>"></i></span>
            <div>
              <div class="fw-semibold"><%= activity.title %></div>
              <div class="small text-muted"><%= activity.detail %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  </main>
</div>
<%- include('../partials/footer') %>
