<%
  const navbarRoleLabels = { ADMIN: 'Administrador', ASISTENTE: 'Asistente de Agencia', CONTABILIDAD: 'Contabilidad' };
%>
<nav class="navbar app-navbar sticky-top px-3 px-lg-4">
  <div class="container-fluid p-0">
    <div class="d-flex align-items-center gap-3">
      <button class="btn btn-light d-lg-none" type="button" data-sidebar-toggle aria-label="Abrir menu" aria-controls="app-sidebar" aria-expanded="false">
        <i class="bi bi-list fs-5"></i>
      </button>
      <a class="navbar-brand d-flex align-items-center gap-2 m-0 fw-bold text-dark" href="<%= homePath %>">
        <span class="brand-mark"><i class="bi bi-check2-square"></i></span>
        <span class="brand-copy"><strong>Planillas de Cheques</strong><small>Procesos Internos ADICLA</small></span>
      </a>
    </div>
    <div class="d-flex align-items-center gap-2">
      <% if (institutionalPortalUrl) { %>
        <a class="btn btn-light d-none d-md-inline-flex align-items-center gap-2" href="<%= institutionalPortalUrl %>" rel="noopener noreferrer">
          <i class="bi bi-grid"></i><span>Portal institucional</span>
        </a>
      <% } %>
      <div class="dropdown">
      <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2" data-bs-toggle="dropdown" type="button">
        <i class="bi bi-person-circle"></i>
        <span class="d-none d-sm-inline"><%= currentUser ? currentUser.nombre : 'Sin sesion' %></span>
      </button>
      <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
        <% if (currentUser) { %>
          <li><span class="dropdown-item-text small text-muted"><%= navbarRoleLabels[currentUser.rol] || currentUser.rol %> · <%= currentUser.agenciaNombre || 'Sin agencia' %></span></li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <form action="/logout" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
              <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesion</button>
            </form>
          </li>
        <% } else { %>
          <li><a class="dropdown-item" href="/login"><i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesion</a></li>
        <% } %>
      </ul>
      </div>
    </div>
  </div>
</nav>
