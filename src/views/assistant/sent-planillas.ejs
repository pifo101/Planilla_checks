<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="app-body">
  <%- include('../partials/sidebar') %>
  <main class="app-main">
    <div class="mb-4"><div class="page-eyebrow">Asistente de agencia</div><h1 class="h3 mb-1">Planillas enviadas</h1><p class="text-muted mb-0">Historial de planillas enviadas por tu agencia.</p></div>
    <section class="card mb-4">
      <div class="card-body p-4">
        <form class="row g-3 align-items-end" method="get">
          <div class="col-sm-6 col-lg-4"><label class="form-label" for="fecha">Fecha de envio</label><input class="form-control" id="fecha" name="fecha" type="date" value="<%= selectedDate %>" required></div>
          <div class="col-auto"><button class="btn btn-primary" type="submit"><i class="bi bi-funnel me-2"></i>Filtrar</button></div>
          <div class="col-auto"><a class="btn btn-outline-secondary" href="/asistente/planillas">Hoy</a></div>
        </form>
      </div>
    </section>
    <section class="card">
      <div class="table-responsive">
        <table class="table table-hover table-extra-wide mb-0">
          <caption class="visually-hidden">Planillas enviadas el <%= selectedDate %></caption>
          <thead><tr><th scope="col">Codigo</th><th scope="col">Numero de acta</th><th scope="col">Fecha de envio</th><th scope="col">Agencia</th><th scope="col" class="cell-number">Registros</th><th scope="col" class="cell-money">Total aprobado</th><th scope="col" class="cell-money">Total cancelado</th><th scope="col" class="cell-money">Descuentos</th><th scope="col" class="cell-money">Monto cheque</th><th scope="col">Estado</th><th scope="col" class="table-actions">Acciones</th></tr></thead>
          <tbody>
            <% if (planillas.length === 0) { %>
              <tr><td class="text-center text-muted py-5" colspan="11">No hay planillas enviadas en la fecha seleccionada.</td></tr>
            <% } %>
            <% planillas.forEach((planilla) => { %>
              <tr><td class="fw-semibold cell-code"><%= planilla.codigo %></td><td class="cell-acta"><%= planilla.numeroActa || 'Sin asignar' %></td><td class="cell-date"><%= dateTime.format(planilla.fechaEnvio) %></td><td><%= planilla.agenciaNombre %></td><td class="cell-number"><%= planilla.cantidadRegistros %></td><td class="cell-money"><%= sqlCurrency.format(planilla.totalAprobado) %></td><td class="cell-money"><%= sqlCurrency.format(planilla.totalCancelado) %></td><td class="cell-money"><%= sqlCurrency.format(planilla.totalDescuentos) %></td><td class="cell-money"><%= sqlCurrency.format(planilla.totalMontoCheque) %></td><td><span class="status-badge status-<%= planilla.estado.toLowerCase() %>"><%= planilla.estado %></span></td><td class="table-actions"><div class="d-flex flex-wrap gap-2"><a class="btn btn-sm btn-outline-primary" href="/asistente/planillas/<%= planilla.id %>?returnTo=<%= encodeURIComponent(returnTo) %>"><i class="bi bi-eye me-1"></i>Ver detalle</a><a class="btn btn-sm btn-primary" href="/asistente/planillas/<%= planilla.id %>/pdf" aria-label="Descargar PDF de la planilla <%= planilla.codigo %>"><i class="bi bi-file-earmark-pdf me-1"></i>Descargar PDF</a></div></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (totalPages > 1) { %>
        <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
          <span class="text-muted small"><%= total %> planillas · Pagina <%= page %> de <%= totalPages %></span>
          <div class="btn-group" aria-label="Paginacion">
            <a class="btn btn-sm btn-outline-secondary <%= page === 1 ? 'disabled' : '' %>" href="?fecha=<%= selectedDate %>&page=<%= page - 1 %>" <%= page === 1 ? 'aria-disabled=true tabindex=-1' : '' %>>Anterior</a>
            <a class="btn btn-sm btn-outline-secondary <%= page === totalPages ? 'disabled' : '' %>" href="?fecha=<%= selectedDate %>&page=<%= page + 1 %>" <%= page === totalPages ? 'aria-disabled=true tabindex=-1' : '' %>>Siguiente</a>
          </div>
        </div>
      <% } %>
    </section>
  </main>
</div>
<%- include('../partials/footer') %>
