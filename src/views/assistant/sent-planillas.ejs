<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="app-body">
  <%- include('../partials/sidebar') %>
  <main class="app-main">
    <div class="mb-4"><div class="page-eyebrow">Asistente de agencia</div><h1 class="h3 mb-1">Planillas enviadas</h1><p class="text-muted mb-0">Historial de demostracion de planillas enviadas.</p></div>
    <section class="card mb-4">
      <div class="card-body p-4">
        <form class="row g-3 align-items-end" method="get">
          <div class="col-sm-6 col-lg-4"><label class="form-label" for="fecha">Fecha</label><input class="form-control" id="fecha" name="fecha" type="date" value="<%= selectedDate %>"></div>
          <div class="col-auto"><button class="btn btn-primary" type="submit"><i class="bi bi-funnel me-2"></i>Filtrar</button></div>
          <div class="col-auto"><a class="btn btn-outline-secondary" href="/asistente/planillas">Limpiar</a></div>
        </form>
      </div>
    </section>
    <section class="card">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th>ID planilla</th><th>Agencia</th><th>Fecha</th><th>Solicitudes</th><th>Total aprobado</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
          <tbody>
            <% planillas.forEach((planilla) => { %><tr><td class="fw-semibold"><%= planilla.id %></td><td><%= planilla.agency %></td><td><%= planilla.date %></td><td><%= planilla.requests %></td><td><%= currency.format(planilla.approved) %></td><td><span class="badge text-bg-light"><%= planilla.status %></span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/asistente/planillas/<%= planilla.id %>"><i class="bi bi-eye me-1"></i>Ver detalle</a></td></tr><% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</div>
<%- include('../partials/footer') %>
