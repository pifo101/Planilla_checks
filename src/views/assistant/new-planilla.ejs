<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="app-body">
  <%- include('../partials/sidebar') %>
  <main class="app-main" data-csrf-token="<%= csrfToken %>">
    <div class="mb-4">
      <div class="page-eyebrow">Asistente de agencia</div>
      <h1 class="h3 mb-1">Nueva planilla</h1>
      <p class="text-muted mb-0">Consulta y agrega solicitudes antes de enviar la planilla.</p>
    </div>

    <section class="card mb-4" data-daily-acta data-acta-available="<%= dailyActa.acta ? 'true' : 'false' %>">
      <div class="card-body p-4">
        <div class="row g-3 align-items-end">
          <div class="col-md-8 col-lg-6">
            <label class="form-label fw-semibold" for="numeroActa">Acta del dia</label>
            <input class="form-control readonly-field <%= dailyActa.acta ? '' : 'd-none' %>" id="numeroActa" data-acta-current type="text" value="<%= dailyActa.acta ? dailyActa.acta.numeroActa : '' %>" readonly>
            <form class="<%= dailyActa.acta ? 'd-none' : '' %>" data-acta-form>
              <label class="visually-hidden" for="numeroActaNueva">Numero de acta del dia</label>
              <div class="input-group">
                <input class="form-control" id="numeroActaNueva" name="numeroActa" data-acta-input type="text" maxlength="50" autocomplete="off" aria-describedby="actaHelp" required>
                <button class="btn btn-primary" type="submit" data-save-acta>Guardar acta</button>
              </div>
            </form>
            <div class="form-text" id="actaHelp" data-acta-help>
              <%= dailyActa.acta
                ? `Acta global vigente para ${dailyActa.fecha}. No puede modificarse durante el dia.`
                : `No hay acta registrada para hoy (${dailyActa.fecha}). Ingrese el numero de acta para continuar.` %>
            </div>
            <div class="alert d-none mt-3 mb-0" role="alert" data-acta-feedback></div>
          </div>
        </div>
      </div>
    </section>

    <form data-solicitud-form>
      <section class="card mb-4">
        <div class="card-body p-4">
          <label class="form-label fw-semibold" for="numeroSolicitud">Numero de solicitud</label>
          <div class="row g-2">
            <div class="col-md-8 col-lg-6">
              <input class="form-control" id="numeroSolicitud" name="numeroSolicitud" placeholder="Ej. 100245" type="text" inputmode="numeric" pattern="[0-9]{1,30}" maxlength="30">
            </div>
            <div class="col-auto">
              <button class="btn btn-primary" type="submit" data-fetch-distribution><i class="bi bi-search me-2"></i>Obtener datos</button>
            </div>
          </div>
          <div class="form-text">La consulta obtiene la distribucion; no agrega ni guarda la solicitud.</div>
          <div class="alert d-none mt-3 mb-0" role="alert" data-request-feedback></div>
        </div>
      </section>

      <section class="card mb-4" data-individual-request>
        <div class="card-header bg-white p-4 pb-0 border-0 d-flex justify-content-between align-items-center">
          <h2 class="h5 mb-0">Informacion de la solicitud</h2>
          <span class="badge text-bg-light">Web Service</span>
        </div>
        <div class="card-body p-4">
          <div class="row g-3">
            <div class="col-md-6"><label class="form-label" for="cliente">Cliente</label><input class="form-control readonly-field" id="cliente" name="cliente" value="<%= typeof previewRequest !== 'undefined' ? previewRequest.nombreCliente : '' %>" readonly></div>
            <div class="col-md-3"><label class="form-label" for="montoAprobado">Monto aprobado</label><input class="form-control readonly-field" id="montoAprobado" name="montoAprobado" value="<%= typeof previewRequest !== 'undefined' ? sqlCurrency.format(previewRequest.montoAprobado) : '' %>" readonly></div>
            <div class="col-md-3"><label class="form-label" for="montoCancelado">Monto cancelado</label><input class="form-control readonly-field" id="montoCancelado" name="montoCancelado" value="<%= typeof previewRequest !== 'undefined' ? sqlCurrency.format(previewRequest.montoCancelado) : '' %>" readonly></div>
            <div class="col-md-3"><label class="form-label" for="descuentos">Descuentos</label><input class="form-control readonly-field" id="descuentos" name="descuentos" value="<%= typeof previewRequest !== 'undefined' ? sqlCurrency.format(previewRequest.descuentos) : '' %>" readonly></div>
            <div class="col-md-3"><label class="form-label" for="montoCheque">Monto cheque</label><input class="form-control readonly-field" id="montoCheque" name="montoCheque" value="<%= typeof previewRequest !== 'undefined' ? sqlCurrency.format(previewRequest.montoCheque) : '' %>" readonly></div>
            <div class="col-md-3"><label class="form-label" for="fechaHora">Fecha y hora</label><input class="form-control readonly-field" id="fechaHora" name="fechaHora" value="<%= typeof previewRequest !== 'undefined' ? dateTime.format(previewRequest.fechaExtraccion) : '' %>" readonly></div>
            <div class="col-md-3"><label class="form-label" for="metodologia">Metodologia</label><input class="form-control readonly-field" id="metodologia" name="metodologia" value="<%= typeof previewRequest !== 'undefined' ? previewRequest.metodologia : '' %>" readonly></div>
            <div class="col-md-6"><label class="form-label" for="agencia">Agencia</label><input class="form-control readonly-field" id="agencia" name="agencia" value="<%= typeof previewRequest !== 'undefined' ? currentUser.agenciaNombre : '' %>" readonly></div>
            <div class="col-md-6"><label class="form-label fw-semibold" for="numeroCheque">Numero de cheque</label><input class="form-control" id="numeroCheque" name="numeroCheque" type="text" placeholder="Ingresa el numero de cheque" pattern="(?:[A-Za-z0-9]|-){1,50}" maxlength="50" autocomplete="off"></div>
          </div>
          <div class="d-flex flex-wrap gap-2 mt-4">
            <button class="btn btn-primary" type="button" data-add-to-draft disabled><i class="bi bi-plus-circle me-2"></i>Agregar a planilla</button>
            <button class="btn btn-outline-secondary" type="button" data-clear-form>Limpiar</button>
          </div>
        </div>
      </section>
      <div class="d-none" data-grouped-request>
        <div class="mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
          <div>
            <h2 class="h5 mb-1">Solicitud grupal <span data-group-request-number></span></h2>
            <p class="text-muted mb-0">Cada emision de cheque se maneja como un miembro independiente.</p>
          </div>
          <span class="badge text-bg-light" data-group-count></span>
        </div>
        <div data-group-members></div>
        <div class="d-flex flex-wrap gap-2 mb-4">
          <button class="btn btn-primary" type="button" data-add-group-to-draft disabled><i class="bi bi-plus-circle me-2"></i>Agregar grupo a planilla</button>
          <button class="btn btn-outline-secondary" type="button" data-clear-group>Limpiar</button>
        </div>
      </div>
    </form>

    <section class="card">
      <div class="card-header bg-white p-4 border-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h5 mb-0">Solicitudes agregadas</h2>
        <span class="badge text-bg-light" data-draft-count><%= typeof previewRequest !== 'undefined' ? '1 registro demostrativo' : '0 registros' %></span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover table-extra-wide mb-0">
          <caption class="visually-hidden">Solicitudes agregadas al borrador de planilla</caption>
          <thead><tr><th scope="col">Solicitud</th><th scope="col">Cliente</th><th scope="col" class="cell-money">Aprobado</th><th scope="col" class="cell-money">Cancelado</th><th scope="col" class="cell-money">Descuentos</th><th scope="col" class="cell-money">Monto cheque</th><th scope="col">Numero cheque</th><th scope="col">Metodologia</th><th scope="col">Fecha</th><th scope="col">Acciones</th></tr></thead>
          <tbody data-draft-body><% if (typeof previewRequest !== 'undefined') { %><tr><td class="cell-code"><%= previewRequest.numeroSolicitud %></td><td><%= previewRequest.nombreCliente %></td><td class="cell-money"><%= sqlCurrency.format(previewRequest.montoAprobado) %></td><td class="cell-money"><%= sqlCurrency.format(previewRequest.montoCancelado) %></td><td class="cell-money"><%= sqlCurrency.format(previewRequest.descuentos) %></td><td class="cell-money"><%= sqlCurrency.format(previewRequest.montoCheque) %></td><td class="cell-check"><%= previewRequest.numeroCheque %></td><td><%= previewRequest.metodologia %></td><td class="cell-date"><%= dateTime.format(previewRequest.fechaExtraccion) %></td><td><span class="text-muted small">Solo demostracion</span></td></tr><% } else { %><tr><td class="text-center text-muted py-4" colspan="10">No hay solicitudes agregadas.</td></tr><% } %></tbody>
          <tfoot class="table-light fw-semibold"><tr><td colspan="2">Totales</td><td class="cell-money" data-total-approved><%= typeof previewRequest !== 'undefined' ? sqlCurrency.format(previewRequest.montoAprobado) : 'Q 0.00' %></td><td class="cell-money" data-total-cancelled><%= typeof previewRequest !== 'undefined' ? sqlCurrency.format(previewRequest.montoCancelado) : 'Q 0.00' %></td><td class="cell-money" data-total-discounts><%= typeof previewRequest !== 'undefined' ? sqlCurrency.format(previewRequest.descuentos) : 'Q 0.00' %></td><td class="cell-money" data-total-check><%= typeof previewRequest !== 'undefined' ? sqlCurrency.format(previewRequest.montoCheque) : 'Q 0.00' %></td><td colspan="4"></td></tr></tfoot>
        </table>
      </div>
      <div class="card-body p-4 text-end">
        <button class="btn btn-success" type="button" data-send-planilla disabled><i class="bi bi-send-check me-2"></i>Enviar planilla</button>
      </div>
    </section>
  </main>
</div>
<%- include('../partials/footer') %>
