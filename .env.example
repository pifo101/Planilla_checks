PORT=3000
SESSION_SECRET=change_this_secret

# SQL Server con autenticacion integrada de Windows
DB_SERVER=localhost\SQLEXPRESS
# Obligatorio; debe coincidir con la base seleccionada mediante sqlcmd -d
DB_DATABASE=PlanillaChecksDB
# Base separada requerida por npm test; debe existir y terminar en TestDB
TEST_DB_DATABASE=PlanillaChecksTestDB
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10

# Cuentas locales requeridas unicamente por npm run seed:dev
DEV_ADMIN_NAME=Development Admin
DEV_ADMIN_EMAIL=admin.local@adicla.org.gt
DEV_ADMIN_PASSWORD=replace_with_local_password
DEV_ASSISTANT_NAME=Development Assistant
DEV_ASSISTANT_EMAIL=assistant.local@adicla.org.gt
DEV_ASSISTANT_PASSWORD=replace_with_local_password
DEV_ASSISTANT_AGENCY_CODE=001
DEV_ACCOUNTING_NAME=Development Accounting
DEV_ACCOUNTING_EMAIL=accounting.local@adicla.org.gt
DEV_ACCOUNTING_PASSWORD=replace_with_local_password

# Solo se requieren al ejecutar npm run create-admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Web Service de distribucion de desembolso
WEBSERVICE_BASE_URL=http://adicla-app.iso.com.gt:7001/ServicioSolicitudesREST/ServicioSolicitudes.svc
WEBSERVICE_TIMEOUT_MS=8000
