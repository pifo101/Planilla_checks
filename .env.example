PORT=3000
SESSION_SECRET=change_this_secret

# SQL Server con autenticacion integrada de Windows
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=PlanillaChecksDB
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10

# Solo se requieren al ejecutar npm run create-admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Web Service de distribucion de desembolso
WEBSERVICE_BASE_URL=http://adicla-app.iso.com.gt:7001/ServicioSolicitudesREST/ServicioSolicitudes.svc
WEBSERVICE_TIMEOUT_MS=8000
